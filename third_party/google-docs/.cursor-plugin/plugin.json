{
  "name": "google-docs",
  "displayName": "Google Docs",
  "version": "0.7.0",
  "minClientVersions": {
    "cursor": "3.19.0"
  },
  "description": "Read, create, and edit Google Docs.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developers.google.com/workspace/guides/configure-mcp-servers",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "google docs",
    "documents",
    "writing",
    "google workspace",
    "mcp"
  ],
  "category": "productivity",
  "tags": [
    "productivity",
    "google workspace",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "A Google OAuth client your team created. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The secret for that OAuth client. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "mcpServers": "./mcp.json"
}
