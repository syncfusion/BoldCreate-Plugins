{
  "name": "google-stitch",
  "displayName": "Stitch",
  "version": "0.7.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Generate UI designs and front-end code with Google Stitch.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://stitch.withgoogle.com/docs/mcp/setup/",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "stitch",
    "ui design",
    "front-end",
    "google",
    "mcp"
  ],
  "category": "design",
  "tags": [
    "design",
    "google",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "STITCH_API_KEY": {
        "type": "string",
        "title": "Stitch API key",
        "description": "API key created in Stitch settings.",
        "x-sensitive": true
      }
    },
    "required": [
      "STITCH_API_KEY"
    ]
  },
  "mcpServers": "./mcp.json"
}
