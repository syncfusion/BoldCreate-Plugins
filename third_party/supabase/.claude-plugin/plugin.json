{
  "name": "supabase",
  "displayName": "Supabase",
  "version": "0.7.0",
  "description": "Query Postgres, manage tables, auth, storage, and edge functions in a Supabase project.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://supabase.com/docs/guides/getting-started/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "keywords": [
    "supabase",
    "postgres",
    "database",
    "auth",
    "storage",
    "mcp"
  ],
  "icon": "./assets/logo.svg",
  "userConfig": {
    "SUPABASE_ACCESS_TOKEN": {
      "type": "string",
      "title": "Supabase personal access token",
      "description": "Create one at https://supabase.com/dashboard/account/tokens.",
      "required": true,
      "sensitive": true
    },
    "SUPABASE_PROJECT_REF": {
      "type": "string",
      "title": "Project ref",
      "description": "The project ID from your project URL. Limits the agent to this one project.",
      "required": true,
      "sensitive": false
    },
    "SUPABASE_READ_ONLY": {
      "type": "string",
      "title": "Read-only mode",
      "description": "\"true\" runs queries as a read-only Postgres user and hides write tools. Set \"false\" to allow writes.",
      "default": "true",
      "sensitive": false
    }
  },
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=${user_config.SUPABASE_PROJECT_REF}&read_only=${user_config.SUPABASE_READ_ONLY}",
      "headers": {
        "Authorization": "Bearer ${user_config.SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
