  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "supabase",
    "postgres",
    "database",
    "auth",
    "storage",
    "mcp"
  ],
  "category": "database",
  "tags": [
    "database",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "SUPABASE_READ_ONLY": {
        "type": "string",
        "title": "Read-only mode",
        "description": "\"true\" runs queries as a read-only Postgres user. Set \"false\" to allow writes.",
        "default": "true",
        "x-sensitive": false
      }
    }
  },
  "skills": "./skills/",
  "mcpServers": "./mcp.json"
