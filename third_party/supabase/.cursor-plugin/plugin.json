  "logo": "assets/logo.svg",
  "keywords": [
    "supabase",
    "postgres",
    "database",
    "auth",
    "storage",
    "mcp"
  ],
  "category": "database",
  "tags": [
    "database",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "SUPABASE_READ_ONLY": {
        "type": "string",
