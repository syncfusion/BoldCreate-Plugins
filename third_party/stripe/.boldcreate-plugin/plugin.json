{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "stripe",
  "displayName": "Stripe",
  "version": "0.7.0",
  "description": "Work with Stripe customers, payments, subscriptions, and search Stripe docs.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.stripe.com/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "payments",
  "keywords": [
    "stripe",
    "payments",
    "billing",
    "subscriptions",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://docs.stripe.com/mcp",
  "rollout": {
    "phase": 1,
    "wave": "A"
  },
  "supportedByGateway": true,
  "variables": {
    "STRIPE_AGENT_KEY": {
      "title": "Stripe agent API key",
      "description": "An API key with the Agent badge from the Stripe Dashboard. From December 2026 the server rejects other secret and restricted keys.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "stripe",
        "transport": "streamable-http",
        "url": "https://mcp.stripe.com",
        "headers": {
          "Authorization": "Bearer ${STRIPE_AGENT_KEY}"
        },
        "auth": {
          "type": "bearer",
          "alternatives": [
            "oauth"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs"
  }
}
