{
  "name": "stripe",
  "displayName": "Stripe",
  "version": "0.7.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Work with Stripe customers, payments, subscriptions, and search Stripe docs.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.stripe.com/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "stripe",
    "payments",
    "billing",
    "subscriptions",
    "mcp"
  ],
  "category": "payments",
  "tags": [
    "payments",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "STRIPE_AGENT_KEY": {
        "type": "string",
        "title": "Stripe agent API key",
        "description": "An API key with the Agent badge from the Stripe Dashboard. From December 2026 the server rejects other secret and restricted keys.",
        "x-sensitive": true
      }
    },
    "required": [
      "STRIPE_AGENT_KEY"
    ]
  },
  "mcpServers": "./mcp.json"
}
