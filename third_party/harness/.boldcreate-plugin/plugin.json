{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "harness",
  "displayName": "Harness",
  "version": "0.1.0",
  "description": "Build, ship and secure your apps on the Harness platform, with Harness skills for pipelines, feature flags, cloud cost, chaos and security.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developer.harness.io/harness-platform/use-harness-ai/connect-with-ai/index/hosted-mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "developer-tools",
  "keywords": [
    "harness",
    "ci-cd",
    "devops",
    "pipelines",
    "gitops",
    "feature-flags",
    "cloud-cost",
    "chaos-engineering",
    "mcp",
    "skills"
  ],
  "hostedBy": "vendor",
  "docs": "https://developer.harness.io/harness-platform/use-harness-ai/connect-with-ai/index/hosted-mcp",
  "upstream": {
    "repository": "https://github.com/harness/harness-ai",
    "path": "plugins/cursor/skills",
    "commit": "ca2ab816842172cab64fe0df5f76d9ff2d286d4f",
    "author": "Harness",
    "license": "Apache-2.0"
  },
  "rollout": {
    "phase": 1,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "CLIENT_ID": {
      "title": "Client ID",
      "description": "The OAuth client ID that Harness documents for its hosted MCP server. It is not a secret. Replace it only if Harness gives your team a different one.",
      "required": false,
      "secret": false,
      "default": "mcp-client"
    }
  },
  "components": {
    "mcp": [
      {
        "name": "harness",
        "transport": "streamable-http",
        "url": "https://mcp.harness.io/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}"
          }
        }
      }
    ],
    "skills": [
      "ai-operations",
      "analyze-costs",
      "approve-exempt",
      "audit-report",
      "chaos-code-risk-scan",
      "chaos-dr-test",
