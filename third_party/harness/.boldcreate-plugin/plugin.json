  "endpointCheck": {
    "lastLiveCheck": "2026-11-13",
    "source": "live probe of https://mcp.harness.io/mcp: unauthenticated initialize returned HTTP 401 with no WWW-Authenticate header; protected-resource metadata at /.well-known/oauth-protected-resource/mcp names https://id.harness.io/idp/realms/HarnessIDP, whose metadata lists a registration endpoint and S256 PKCE"
  }
}
