{
  "name": "posthog",
  "displayName": "PostHog",
  "version": "0.7.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Query product analytics, manage feature flags, and investigate errors in PostHog.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://posthog.com/docs/model-context-protocol",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "posthog",
    "analytics",
    "feature-flags",
    "errors",
    "mcp"
  ],
  "category": "analytics",
  "tags": [
    "analytics",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "POSTHOG_API_KEY": {
        "type": "string",
        "title": "PostHog personal API key",
        "description": "Create one in PostHog under Settings > Personal API keys, using the MCP Server preset.",
        "x-sensitive": true
      }
    },
    "required": [
      "POSTHOG_API_KEY"
    ]
  },
  "mcpServers": "./mcp.json"
}
