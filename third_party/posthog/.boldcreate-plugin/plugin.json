{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "posthog",
  "displayName": "PostHog",
  "version": "0.7.1",
  "description": "Work with PostHog from chat: query product analytics and run SQL, manage feature flags and experiments, triage error tracking issues, and review session replays, surveys, and dashboards.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://posthog.com/docs/model-context-protocol",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "category": "analytics",
  "keywords": [
    "posthog",
    "analytics",
    "feature-flags",
    "errors",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://posthog.com/docs/model-context-protocol",
  "rollout": {
    "phase": 1,
    "wave": "A"
  },
  "supportedByGateway": true,
  "variables": {},
  "components": {
    "mcp": [
      {
        "name": "posthog",
        "transport": "streamable-http",
        "url": "https://mcp.posthog.com/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [
            "bearer"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "official docs"
  }
}
