            "header"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": "2026-11-13",
    "source": "live probe of https://mcp.mermaid.ai/mcp: unauthenticated initialize returned HTTP 401 with WWW-Authenticate Bearer and a resource_metadata link; the authorization server named there lists a registration endpoint and S256 PKCE"
  }
}
