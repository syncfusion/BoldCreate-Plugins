  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "design",
  "keywords": [
    "mermaid",
    "diagrams",
    "flowchart",
    "sequence-diagram",
    "rendering",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://mermaid.ai/docs/ai/mcp-server",
