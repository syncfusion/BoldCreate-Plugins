  "endpointCheck": {
    "lastLiveCheck": "2026-11-16",
    "source": "live probe of https://mcp.morningstar.com/mcp: unauthenticated initialize returned HTTP 401 with no WWW-Authenticate header; protected-resource metadata at /.well-known/oauth-protected-resource/mcp names the server as its own authorization server, whose metadata lists a registration endpoint and S256 PKCE"
  }
}
