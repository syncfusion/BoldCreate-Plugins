{
  "name": "github",
  "displayName": "GitHub",
  "version": "0.7.0",
  "description": "Manage repos, issues, pull requests, and Actions.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.github.com/en/copilot/how-tos/context/use-mcp/use-the-github-mcp-server",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "keywords": [
    "github",
    "git",
    "pull-requests",
    "issues",
    "actions",
    "mcp"
  ],
  "icon": "./assets/logo.svg",
  "userConfig": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": {
      "type": "string",
      "title": "GitHub personal access token",
      "description": "Fine-grained or classic PAT from https://github.com/settings/tokens with the repo scopes you want the agent to use.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${user_config.GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
