{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "neon",
  "displayName": "Neon",
  "version": "0.7.1",
  "description": "Manage Neon serverless Postgres projects, branches, queries, and migrations.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://github.com/neondatabase-labs/mcp-server-neon",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "database",
  "keywords": [
    "neon",
    "postgres",
    "database",
    "serverless",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://github.com/neondatabase-labs/mcp-server-neon",
  "rollout": {
    "phase": 1,
    "wave": "A"
  },
  "supportedByGateway": true,
  "variables": {
    "NEON_READ_ONLY": {
      "title": "Read-only mode",
      "description": "\"true\" disables write tools. Set \"false\" to allow writes.",
      "required": false,
      "secret": false,
      "default": "true"
    }
  },
  "components": {
    "mcp": [
      {
        "name": "neon",
        "transport": "streamable-http",
        "url": "https://mcp.neon.tech/mcp?readonly=${NEON_READ_ONLY}",
        "auth": {
          "type": "oauth",
          "alternatives": [
            "bearer"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs"
  }
}
