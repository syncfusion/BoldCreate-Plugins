{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "gitlab",
  "displayName": "GitLab",
  "version": "0.7.0",
  "description": "Work with GitLab projects, issues, merge requests, pipelines, and code search.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.gitlab.com/user/model_context_protocol/mcp_server/",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "source-control",
  "keywords": [
    "gitlab",
    "git",
    "merge requests",
    "ci/cd",
    "issues",
    "mcp"
  ],
  "hostedBy": "vendor",
  "stage": "ga",
  "docs": "https://docs.gitlab.com/user/model_context_protocol/mcp_server/",
  "rollout": {
    "phase": 2,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "GITLAB_HOST": {
      "title": "GitLab host",
      "description": "Host name of your GitLab instance. Keep gitlab.com for GitLab.com, or enter your self-managed host, such as gitlab.example.com.",
      "required": false,
      "secret": false,
      "default": "gitlab.com"
    }
  },
  "components": {
    "mcp": [
      {
        "name": "gitlab",
        "transport": "streamable-http",
        "url": "https://${GITLAB_HOST}/api/v4/mcp",
        "auth": {
          "type": "oauth",
          "alternatives": [
            "bearer"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs"
  }
}
