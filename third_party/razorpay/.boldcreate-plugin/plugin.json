  "endpointCheck": {
    "lastLiveCheck": "2026-11-13",
    "source": "live probe of https://mcp.razorpay.com/mcp: unauthenticated initialize returned HTTP 401 with WWW-Authenticate Bearer and a resource_metadata link; authorization server metadata lists a registration endpoint and S256 PKCE"
  }
