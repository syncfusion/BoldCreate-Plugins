{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "linear",
  "displayName": "Linear",
  "version": "0.7.0",
  "description": "Find, create, and update Linear issues, projects, and cycles.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://linear.app/docs/mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "project-management",
  "keywords": [
    "linear",
    "issues",
    "project-management",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://linear.app/docs/mcp",
  "rollout": {
    "phase": 1,
    "wave": "A"
  },
  "supportedByGateway": true,
  "variables": {
    "LINEAR_API_KEY": {
      "title": "Linear API key",
      "description": "Personal API key from Linear Settings > Security & access. Tool calls run as the key's owner.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "linear",
        "transport": "streamable-http",
        "url": "https://mcp.linear.app/mcp",
        "headers": {
          "Authorization": "Bearer ${LINEAR_API_KEY}"
        },
        "auth": {
          "type": "bearer",
          "alternatives": [
            "oauth"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs"
  }
}
