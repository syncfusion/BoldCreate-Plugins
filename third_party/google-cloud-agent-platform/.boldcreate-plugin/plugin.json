            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/cloud-platform"
          ]
        }
      },
      {
        "name": "agent-platform-models",
        "transport": "streamable-http",
        "url": "https://aiplatform.googleapis.com/mcp/models",
        "auth": {
