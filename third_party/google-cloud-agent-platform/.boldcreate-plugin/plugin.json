{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "google-cloud-agent-platform",
  "displayName": "Gemini Enterprise Agent Platform (Vertex AI)",
  "version": "0.7.0",
  "description": "Generate content, run predictions, and manage models, endpoints, tuning, and evaluation on Vertex AI.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.cloud.google.com/gemini-enterprise-agent-platform/reference/use-agent-platform-mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "ai",
  "keywords": [
    "vertex ai",
    "gemini",
    "agent platform",
    "machine learning",
    "models",
    "mcp"
  ],
  "hostedBy": "vendor",
  "stage": "ga",
  "docs": "https://docs.cloud.google.com/gemini-enterprise-agent-platform/reference/use-agent-platform-mcp",
  "rollout": {
    "phase": 2,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "CLIENT_ID": {
      "title": "Client ID",
      "description": "A Google OAuth client your team created. Every team member signs in under it.",
      "required": true,
      "secret": false
    },
    "CLIENT_SECRET": {
      "title": "Client secret",
      "description": "The secret for that OAuth client. Stored encrypted.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "agent-platform-generate",
        "transport": "streamable-http",
        "url": "https://aiplatform.googleapis.com/mcp/generate",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/cloud-platform"
          ]
        }
      },
      {
        "name": "agent-platform-predict",
        "transport": "streamable-http",
        "url": "https://aiplatform.googleapis.com/mcp/predict",
        "auth": {
          "type": "oauth",
          "alternatives": [],
