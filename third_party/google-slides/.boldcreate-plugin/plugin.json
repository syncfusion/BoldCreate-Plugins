{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "google-slides",
  "displayName": "Google Slides",
  "version": "0.7.0",
  "description": "Read, create, and edit Google Slides presentations.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developers.google.com/workspace/guides/configure-mcp-servers",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "productivity",
  "keywords": [
    "google slides",
    "presentations",
    "slides",
    "google workspace",
    "mcp"
  ],
  "hostedBy": "vendor",
  "stage": "preview",
  "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers",
  "rollout": {
    "phase": 2,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {
    "CLIENT_ID": {
      "title": "Client ID",
      "description": "A Google OAuth client your team created. Every team member signs in under it.",
      "required": true,
      "secret": false
    },
    "CLIENT_SECRET": {
      "title": "Client secret",
      "description": "The secret for that OAuth client. Stored encrypted.",
      "required": true,
      "secret": true
    }
  },
  "components": {
    "mcp": [
      {
        "name": "google-slides",
        "transport": "streamable-http",
        "url": "https://slidesmcp.googleapis.com/mcp/v1",
        "auth": {
          "type": "oauth",
          "alternatives": [],
          "oauthClient": {
            "clientId": "${CLIENT_ID}",
            "clientSecret": "${CLIENT_SECRET}"
          },
          "scopes": [
            "https://www.googleapis.com/auth/drive.readonly",
            "https://www.googleapis.com/auth/drive.file",
            "https://www.googleapis.com/auth/presentations.readonly",
            "https://www.googleapis.com/auth/presentations"
          ]
        }
      }
    ],
    "skills": [],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": null,
    "source": "vendor docs (developers.google.com/workspace/guides/configure-mcp-servers)"
  }
}
