{
  "name": "google-cloud-bigquery",
  "displayName": "Google Cloud BigQuery",
  "version": "0.7.0",
  "minClientVersions": {
    "cursor": "3.19.0"
  },
  "description": "Explore datasets and tables and run SQL queries.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.cloud.google.com/bigquery/docs/use-bigquery-mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "bigquery",
    "sql",
    "analytics",
    "data warehouse",
    "mcp"
  ],
  "category": "database",
  "tags": [
    "database",
    "google cloud",
    "mcp",
    "http"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Client ID",
        "description": "A Google OAuth client your team created. Every team member signs in under it.",
        "x-sensitive": false
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Client secret",
        "description": "The secret for that OAuth client. Stored encrypted.",
        "writeOnly": true,
        "format": "password",
        "x-sensitive": true
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "mcpServers": "./mcp.json"
}
