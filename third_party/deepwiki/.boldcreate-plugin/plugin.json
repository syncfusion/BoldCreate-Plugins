  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://docs.devin.ai/work-with-devin/deepwiki-mcp",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "documentation",
  "keywords": [
    "github",
    "docs",
    "codebase",
    "wiki",
    "mcp"
  ],
  "hostedBy": "vendor",
  "docs": "https://docs.devin.ai/work-with-devin/deepwiki-mcp",
  "rollout": {
    "phase": 1,
    "wave": "A"
  },
  "supportedByGateway": true,
  "variables": {},
  "components": {
    "mcp": [
      {
        "name": "deepwiki",
        "transport": "streamable-http",
