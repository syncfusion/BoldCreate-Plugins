{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/syncfusion/BoldCreate-Plugins/schemas/boldcreate-plugin.schema.json",
  "title": "BoldCreate Connect plugin manifest",
  "description": "<plugin>/.boldcreate-plugin/plugin.json, where <plugin> is third_party/<name> or a first-party <name> at the repo root. Self-contained: everything BoldCreate needs to ingest, review and install the plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "license", "logo", "rollout", "variables", "components", "supportedByGateway"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
    "displayName": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "url": { "type": "string" } }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "logo": { "type": "string", "pattern": "^assets/[^/]+\\.(svg|png)$", "description": "Logo path relative to the plugin folder." },
    "category": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "hostedBy": { "enum": ["vendor", "customer", "boldcreate", "local"] },
    "stage": { "enum": ["ga", "preview", "beta", "early-access"] },
    "docs": { "type": "string", "format": "uri" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "commit", "license"],
      "description": "Where a community plugin was copied from. The original LICENSE file stays in the plugin folder.",
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "path": { "type": "string", "description": "Plugin folder inside the source repository." },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "author": { "type": "string", "description": "Author named in the source manifest." },
        "license": { "type": "string" }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": { "phase": { "type": "integer", "minimum": 1 }, "wave": { "enum": ["A", "B"] } }
    },
    "supportedByGateway": { "type": "boolean", "description": "True when the plugin has MCP components and every one uses a transport the gateway supports today." },
    "variables": {
      "type": "object",
      "description": "Install-time values. Secrets are sealed and injected by the gateway; they replace ${KEY} in url and headers.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "required", "secret"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "secret": { "type": "boolean" },
          "default": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp", "skills", "rules", "hooks", "agents", "commands"],
      "properties": {
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "transport", "auth"],
            "properties": {
              "name": { "type": "string" },
              "transport": { "enum": ["streamable-http", "stdio", "sse", "websocket"] },
              "url": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["none", "bearer", "header", "basic-api-token", "oauth"] },
                  "alternatives": { "type": "array", "items": { "enum": ["none", "bearer", "header", "basic-api-token", "oauth"] } },
                  "oauthClient": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["clientId", "clientSecret"],
                    "description": "Pre-registered OAuth client, as ${VARIABLE} references.",
                    "properties": { "clientId": { "type": "string" }, "clientSecret": { "type": "string" } }
                  },
                  "scopes": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "skills": { "type": "array", "items": { "type": "string" }, "description": "Skill folder names under skills/." },
        "rules": { "type": "array", "items": { "type": "string" }, "description": "Rule names under rules/, without .mdc." },
        "hooks": { "type": "array", "items": { "type": "string" }, "description": "Hook event names in hooks/claude-hooks.json." },
        "agents": { "type": "array", "items": { "type": "string" }, "description": "Agent names under agents/, without .md." },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "endpointCheck": {
      "type": ["object", "null"],
      "properties": { "lastLiveCheck": { "type": ["string", "null"] }, "source": { "type": "string" } }
    }
  }
}
