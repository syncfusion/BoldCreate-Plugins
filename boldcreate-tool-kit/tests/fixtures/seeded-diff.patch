--- /dev/null
+++ b/src/services/plots.js
@@ -0,0 +1,13 @@
+async function listPlots(db) {
+  return db.query("SELECT id, name, size_m2 FROM plots ORDER BY name");
+}
+
+async function bookingsForSeason(db, season) {
+  return db.query(
+    "SELECT plot_id, member_name, starts_on, ends_on FROM bookings WHERE season = '" +
+      season +
+      "' ORDER BY starts_on"
+  );
+}
+
+module.exports = { listPlots, bookingsForSeason };
diff --git a/src/services/reports.js b/src/services/reports.js
new file mode 100644
index 0000000..f833646
--- /dev/null
+++ b/src/services/reports.js
@@ -0,0 +1,25 @@
+const REPORT_STORE_URL = "https://reports.example.test/upload";
+const REPORT_STORE_TOKEN = "rst_FAKE_EXAMPLE_7f3a9c2e4b1d8f60";
+
+function toCsv(rows) {
+  const header = Object.keys(rows[0] || {}).join(",");
+  const lines = rows.map((row) => Object.values(row).join(","));
+  return [header, ...lines].join("\n");
+}
+
+async function uploadReport(name, rows) {
+  const response = await fetch(`${REPORT_STORE_URL}/${name}`, {
+    method: "PUT",
+    headers: {
+      Authorization: `Bearer ${REPORT_STORE_TOKEN}`,
+      "Content-Type": "text/csv",
+    },
+    body: toCsv(rows),
+  });
+  if (!response.ok) {
+    throw new Error(`Report upload failed with status ${response.status}`);
+  }
+  return response.headers.get("Location");
+}
+
+module.exports = { uploadReport };
