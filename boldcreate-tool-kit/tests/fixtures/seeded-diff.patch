diff --git a/src/routes/plots.js b/src/routes/plots.js
new file mode 100644
index 0000000..d80e997
--- /dev/null
+++ b/src/routes/plots.js
@@ -0,0 +1,23 @@
+const express = require("express");
+const { listPlots, bookingsForSeason } = require("../services/plots");
+const { uploadReport } = require("../services/reports");
+
+const router = express.Router();
+
+router.get("/plots", async (req, res) => {
+  const plots = await listPlots(req.db);
+  res.json(plots);
+});
+
+router.get("/plots/bookings", async (req, res) => {
+  const bookings = await bookingsForSeason(req.db, req.query.season);
+  res.json(bookings);
+});
+
+router.post("/plots/bookings/export", async (req, res) => {
+  const bookings = await bookingsForSeason(req.db, req.body.season);
+  const url = await uploadReport(`bookings-${req.body.season}.csv`, bookings);
+  res.status(201).json({ url });
+});
+
+module.exports = router;
diff --git a/src/services/plots.js b/src/services/plots.js
